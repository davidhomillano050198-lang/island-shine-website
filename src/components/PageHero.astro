---
// Reusable inner-page hero: breadcrumb + eyebrow + title + subtitle over an
// ambient high-tech backdrop (grid + glow blobs + optional faded photo).
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
  crumb?: string;
}
const { eyebrow, title, subtitle, image, crumb } = Astro.props;
---

<section class="relative isolate overflow-hidden bg-paper pt-32 pb-16 lg:pt-40 lg:pb-24">
  {image && (
    <div class="absolute inset-0 -z-20" aria-hidden="true">
      <Image src={image} alt="" widths={[768, 1280, 1920]} sizes="100vw" class="h-full w-full object-cover opacity-[0.28]" loading="eager" />
      <div class="absolute inset-0 bg-gradient-to-b from-paper/55 via-paper/80 to-paper"></div>
    </div>
  )}
  <div class="svc-bg" aria-hidden="true">
    <span class="blob blob-blue"></span>
    <span class="blob blob-yellow-2"></span>
  </div>
  <div class="svc-grid absolute inset-0" aria-hidden="true"></div>

  <div class="relative z-10 mx-auto max-w-7xl px-6 sm:px-8">
    <nav class="reveal flex flex-wrap items-center gap-2 text-sm text-ink-600" aria-label="Breadcrumb">
      <a href="/" class="transition-colors hover:text-brand-blue-600">Home</a>
      <Icon name="tabler:chevron-right" class="h-4 w-4 opacity-50" />
      <span class="font-medium text-ink">{crumb ?? title}</span>
    </nav>

    {eyebrow && (
      <p class="reveal mt-7 inline-flex items-center gap-2.5 text-xs font-semibold uppercase tracking-[0.22em] text-brand-blue-600">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#00d4ff] opacity-70"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-[#00d4ff]"></span>
        </span>
        {eyebrow}
      </p>
    )}

    <h1 class="reveal mt-5 max-w-4xl font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-ink sm:text-5xl lg:text-[3.75rem]">
      {title}
    </h1>
    {subtitle && <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-ink-600">{subtitle}</p>}
    <slot />
  </div>
</section>
