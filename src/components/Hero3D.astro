---
// Futuristic 3D hero centerpiece: glowing crystalline energy core + particle
// field, lit with additive glow (core three.js only — no postprocessing).
// Lazy-loaded, reduced-motion-safe, pauses when offscreen.
---
<div id="hero3d" class="relative h-[20rem] w-full sm:h-[26rem] lg:h-[34rem]" role="img" aria-label="Animated 3D cleaning-technology energy core"></div>

<script>
  const mount = document.getElementById("hero3d");
  const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
  let started = false;

  async function init() {
    if (started || !mount) return;
    started = true;
    try {
    const THREE = await import("three");

    const CYAN = 0x00d4ff, BLUE = 0x4d6df0, WHITE = 0xdcefff;
    let w = mount.clientWidth || 600, h = mount.clientHeight || 400;
    const small = w < 640;

    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, small ? 1.5 : 2));
    renderer.setSize(w, h);
    mount.appendChild(renderer.domElement);

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(45, w / h, 0.1, 100);
    camera.position.set(0, 0, 7.5);

    const group = new THREE.Group();
    scene.add(group);

    // solid faceted core
    const core = new THREE.Mesh(
      new THREE.IcosahedronGeometry(1.7, 1),
      new THREE.MeshStandardMaterial({ color: 0x0b1838, metalness: 0.9, roughness: 0.2, transparent: true, opacity: 0.92 })
    );
    group.add(core);
    // glowing wireframe shell
    group.add(new THREE.LineSegments(
      new THREE.WireframeGeometry(new THREE.IcosahedronGeometry(1.76, 1)),
      new THREE.LineBasicMaterial({ color: CYAN, transparent: true, opacity: 0.9 })
    ));
    // outer rotating halo wire
    const halo = new THREE.LineSegments(
      new THREE.WireframeGeometry(new THREE.IcosahedronGeometry(2.6, 0)),
      new THREE.LineBasicMaterial({ color: BLUE, transparent: true, opacity: 0.4 })
    );
    group.add(halo);
    // additive glow layers (fake bloom)
    const glow1 = new THREE.Mesh(
      new THREE.SphereGeometry(1.25, 32, 32),
      new THREE.MeshBasicMaterial({ color: CYAN, transparent: true, opacity: 0.5, blending: THREE.AdditiveBlending })
    );
    group.add(glow1);
    const glow2 = new THREE.Mesh(
      new THREE.SphereGeometry(2.2, 32, 32),
      new THREE.MeshBasicMaterial({ color: BLUE, transparent: true, opacity: 0.14, blending: THREE.AdditiveBlending })
    );
    group.add(glow2);

    // particle field
    const N = small ? 340 : 760;
    const pos = new Float32Array(N * 3);
    for (let i = 0; i < N; i++) {
      const r = 4 + Math.random() * 6, t = Math.random() * Math.PI * 2, p = Math.acos(2 * Math.random() - 1);
      pos[i * 3] = r * Math.sin(p) * Math.cos(t);
      pos[i * 3 + 1] = r * Math.sin(p) * Math.sin(t);
      pos[i * 3 + 2] = r * Math.cos(p);
    }
    const pGeo = new THREE.BufferGeometry();
    pGeo.setAttribute("position", new THREE.BufferAttribute(pos, 3));
    const particles = new THREE.Points(pGeo, new THREE.PointsMaterial({ color: WHITE, size: 0.04, transparent: true, opacity: 0.75, blending: THREE.AdditiveBlending }));
    scene.add(particles);

    scene.add(new THREE.AmbientLight(0x8da0ff, 0.8));
    const l1 = new THREE.PointLight(CYAN, 2.6, 60); l1.position.set(4, 3, 6); scene.add(l1);
    const l2 = new THREE.PointLight(BLUE, 1.8, 60); l2.position.set(-5, -3, 3); scene.add(l2);

    group.scale.setScalar(reduce ? 1 : 0.2);
    let mx = 0, my = 0;
    if (matchMedia("(hover: hover)").matches && !reduce) {
      mount.addEventListener("pointermove", (e) => {
        const r = mount.getBoundingClientRect();
        mx = (e.clientX - r.left) / r.width - 0.5;
        my = (e.clientY - r.top) / r.height - 0.5;
      });
      mount.addEventListener("pointerleave", () => { mx = 0; my = 0; });
    }

    const clock = new THREE.Clock();
    let raf = 0;
    const frame = () => {
      const t = clock.getElapsedTime();
      if (group.scale.x < 0.999) group.scale.setScalar(group.scale.x + (1 - group.scale.x) * 0.06);
      if (!reduce) {
        group.rotation.y = t * 0.22 + mx * 0.7;
        group.rotation.x = Math.sin(t * 0.3) * 0.1 - my * 0.5;
        halo.rotation.y = -t * 0.16;
        halo.rotation.x = t * 0.1;
        glow1.material.opacity = 0.42 + Math.sin(t * 1.6) * 0.16;
        particles.rotation.y = t * 0.03;
        group.position.y = Math.sin(t * 0.8) * 0.12;
      }
      renderer.render(scene, camera);
      raf = requestAnimationFrame(frame);
    };
    const start = () => { if (!raf && !reduce) raf = requestAnimationFrame(frame); };
    const stop = () => { if (raf) { cancelAnimationFrame(raf); raf = 0; } };

    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(mount);
    new ResizeObserver(() => {
      w = mount.clientWidth; h = mount.clientHeight;
      camera.aspect = w / h; camera.updateProjectionMatrix(); renderer.setSize(w, h);
    }).observe(mount);

    if (reduce) renderer.render(scene, camera); else start();
    } catch (e) { console.error("[h3d] ERR", e && (e.message || e)); }
  }

  // Hero is above the fold, so init eagerly (the render loop still pauses
  // itself when scrolled offscreen via the IntersectionObserver in init).
  if (mount) init();
</script>
