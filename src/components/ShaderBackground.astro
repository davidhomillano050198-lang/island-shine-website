---
// Real-time GPU-rendered gradient (raw WebGL). Falls back silently to the
// section's solid brand-blue if WebGL is unavailable, and renders a single
// static frame under prefers-reduced-motion.
---
<canvas id="shader-bg" class="absolute inset-0 -z-10 h-full w-full" aria-hidden="true"></canvas>

<script>
  const canvas = document.getElementById("shader-bg") as HTMLCanvasElement | null;
  const gl = canvas?.getContext("webgl", { alpha: true, antialias: false, powerPreference: "low-power" });
  if (canvas && gl) {
    const vs = "attribute vec2 p; void main(){ gl_Position = vec4(p, 0.0, 1.0); }";
    const fs = `
      precision mediump float;
      uniform vec2 u_res; uniform float u_time;
      void main(){
        vec2 uv = gl_FragCoord.xy / u_res.xy;
        vec2 p = uv * 3.0;
        float t = u_time * 0.18;
        float v = 0.0;
        v += sin(p.x * 1.5 + t);
        v += sin(p.y * 1.8 - t * 1.1);
        v += sin((p.x + p.y) * 1.2 + t * 0.7);
        vec2 q = vec2(sin(p.y + t), cos(p.x - t));
        v += sin((p.x + q.x) * 1.1 + (p.y + q.y) * 1.3 + t);
        v *= 0.25;
        float m = 0.5 + 0.5 * v;
        vec3 blueDark = vec3(0.133, 0.227, 0.569);
        vec3 blue = vec3(0.239, 0.365, 0.831);
        vec3 yellow = vec3(0.988, 0.745, 0.075);
        vec3 col = mix(blueDark, blue, smoothstep(0.15, 0.85, m));
        float glow = smoothstep(0.55, 1.0, m) * (0.5 + 0.5 * sin(t * 1.2));
        float region = smoothstep(0.25, 1.0, uv.x) * smoothstep(0.15, 1.0, uv.y);
        col = mix(col, yellow, glow * 0.30 * region);
        gl_FragColor = vec4(col, 1.0);
      }`;
    const sh = (type: number, src: string) => {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src); gl.compileShader(s); return s;
    };
    const prog = gl.createProgram()!;
    gl.attachShader(prog, sh(gl.VERTEX_SHADER, vs));
    gl.attachShader(prog, sh(gl.FRAGMENT_SHADER, fs));
    gl.linkProgram(prog); gl.useProgram(prog);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, "p");
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const uRes = gl.getUniformLocation(prog, "u_res");
    const uTime = gl.getUniformLocation(prog, "u_time");
    const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
    const resize = () => {
      const w = Math.max(1, (canvas.clientWidth * dpr) | 0);
      const h = Math.max(1, (canvas.clientHeight * dpr) | 0);
      canvas.width = w; canvas.height = h; gl.viewport(0, 0, w, h);
    };
    new ResizeObserver(resize).observe(canvas);
    resize();
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const draw = (tSec: number) => {
      gl.uniform2f(uRes, canvas.width, canvas.height);
      gl.uniform1f(uTime, tSec);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    };
    if (reduce) {
      draw(0);
    } else {
      const t0 = performance.now();
      let raf = 0, running = false;
      const loop = (now: number) => { if (!running) return; draw((now - t0) / 1000); raf = requestAnimationFrame(loop); };
      const start = () => { if (!running) { running = true; raf = requestAnimationFrame(loop); } };
      const stop = () => { running = false; if (raf) cancelAnimationFrame(raf); raf = 0; };
      new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(canvas);
      document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
      start();
    }
  } else if (canvas) {
    canvas.style.display = "none";
  }
</script>
