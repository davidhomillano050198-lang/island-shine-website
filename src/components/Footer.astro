---
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import logo from "../assets/images/logo.png";
import { site, waLink } from "../data/site";
const year = 2026;
const services = [
  { label: "Building painting", href: "/services/building-painting" },
  { label: "Renovation", href: "/services/renovation" },
  { label: "Post-renovation cleaning", href: "/services/post-renovation-cleaning" },
  { label: "Contract cleaning", href: "/services/contract-cleaning" },
  { label: "High-rise cleaning", href: "/services/high-rise-cleaning" },
  { label: "Factory & industrial", href: "/services/factory-industrial-cleaning" },
];
const explore = [
  { label: "About", href: "/about" },
  { label: "How we work", href: "/how-we-work" },
  { label: "Services", href: "/services" },
  { label: "Gallery", href: "/gallery" },
  { label: "Reviews", href: "/reviews" },
  { label: "Contact", href: "/contact" },
];
---

<footer class="relative border-t border-white/10 bg-[#05070f] text-white/70">
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <div class="grid gap-10 md:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-1">
        <Image src={logo} alt="Island Shine Cleaning Services & Renovation" width={1526} height={1079} class="h-16 w-auto" />

        <p class="mt-3 max-w-xs text-sm leading-relaxed">
          CIDB-certified painting, renovation and post-renovation cleaning. Fully insured, eco-friendly, and trusted on 3000+ projects across Penang, Butterworth & Kulim.
        </p>
        <span class="mt-4 inline-flex items-center gap-2 rounded-full bg-white/10 px-3 py-1 text-xs font-medium text-white">
          <Icon name="tabler:rosette-discount-check" class="h-4 w-4 text-brand-yellow" /> CIDB Malaysia certified
        </span>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-white">Services</h2>
        <ul class="mt-4 space-y-2.5 text-sm">
          {services.map((s) => (
            <li><a href={s.href} class="transition-colors hover:text-brand-yellow">{s.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-white">Contact</h2>
        <ul class="mt-4 space-y-3 text-sm">
          {site.phones.map((p) => (
            <li class="flex items-start gap-2.5">
              <Icon name="tabler:brand-whatsapp" class="mt-0.5 h-4 w-4 shrink-0 text-brand-yellow" />
              <a href={waLink(p.tel.replace("+", ""), site.whatsapp.prefill)} target="_blank" rel="noopener" class="hover:text-brand-yellow">{p.display}<span class="block text-xs text-white/50">{p.name}</span></a>
            </li>
          ))}
          <li class="flex items-start gap-2.5">
            <Icon name="tabler:mail" class="mt-0.5 h-4 w-4 shrink-0 text-brand-yellow" />
            <a href={`mailto:${site.email}`} class="hover:text-brand-yellow">{site.email}</a>
          </li>
        </ul>
      </div>

      <div>
        <h2 class="font-display text-sm font-semibold uppercase tracking-wide text-white">Visit us</h2>
        <address class="mt-4 text-sm not-italic leading-relaxed">
          {site.address.lines.map((l) => (<span class="block">{l}</span>))}
        </address>
        <div class="mt-4 flex gap-3">
          <a href={site.facebook} target="_blank" rel="noopener" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-brand-yellow hover:text-ink" aria-label="Island Shine on Facebook">
            <Icon name="tabler:brand-facebook" class="h-5 w-5" />
          </a>
          <a href={waLink(site.whatsapp.number, site.whatsapp.prefill)} target="_blank" rel="noopener" class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-white/10 transition-colors hover:bg-brand-yellow hover:text-ink" aria-label="Island Shine on WhatsApp">
            <Icon name="tabler:brand-whatsapp" class="h-5 w-5" />
          </a>
        </div>
      </div>
    </div>

    <nav class="mt-12 flex flex-wrap gap-x-6 gap-y-2 border-t border-white/10 pt-6 text-sm" aria-label="Footer">
      {explore.map((e) => (
        <a href={e.href} class="text-white/60 transition-colors hover:text-brand-yellow">{e.label}</a>
      ))}
    </nav>
    <div class="mt-6 text-xs text-white/50">
      &copy; {year} {site.name}. {site.serviceArea}.
    </div>
  </div>
</footer>
