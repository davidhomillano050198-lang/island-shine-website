  <script>
    // Paint-trail effect: soft brand-colour brush strokes follow the cursor
    // across the hero and fade like drying paint. Hover devices only,
    // reduced-motion safe, and capped so it can never hurt performance.
    const heroEl = document.querySelector<HTMLElement>(".hero");
    const paint = document.getElementById("paint-canvas") as HTMLCanvasElement | null;
    if (
      heroEl && paint &&
      matchMedia("(hover: hover)").matches &&
      !matchMedia("(prefers-reduced-motion: reduce)").matches
    ) {
      const ctx = paint.getContext("2d")!;
      const colors = ["61,93,212", "252,190,19", "10,162,196"]; // brand blue, gold, cyan
      const LIFE = 1900; // ms a stroke stays wet
      const dpr = Math.min(devicePixelRatio || 1, 2);
      let stamps: { x: number; y: number; r: number; c: string; a: number; born: number }[] = [];
      let raf = 0, lastPt: { x: number; y: number } | null = null, ci = 0, run = 0;

      const resize = () => { paint.width = heroEl.clientWidth * dpr; paint.height = heroEl.clientHeight * dpr; };
      resize();
      addEventListener("resize", resize);

      const loop = () => {
        ctx.clearRect(0, 0, paint.width, paint.height);
        const now = performance.now();
        stamps = stamps.filter((s) => now - s.born < LIFE);
        for (const s of stamps) {
          const life = 1 - (now - s.born) / LIFE;
          const g = ctx.createRadialGradient(s.x, s.y, 0, s.x, s.y, s.r);
          g.addColorStop(0, `rgba(${s.c},${s.a * life})`);
          g.addColorStop(1, `rgba(${s.c},0)`);
          ctx.fillStyle = g;
          ctx.beginPath();
          ctx.arc(s.x, s.y, s.r, 0, 6.2832);
          ctx.fill();
        }
        raf = stamps.length ? requestAnimationFrame(loop) : 0;
      };

      heroEl.addEventListener("pointermove", (e) => {
        const rect = heroEl.getBoundingClientRect();
        const x = (e.clientX - rect.left) * dpr;
        const y = (e.clientY - rect.top) * dpr;
        if (lastPt) {
          const dx = x - lastPt.x, dy = y - lastPt.y;
          const d = Math.hypot(dx, dy);
          const steps = Math.max(1, Math.floor(d / (16 * dpr)));
          for (let i = 1; i <= steps; i++) {
            run += d / steps;
            if (run > 140 * dpr) { ci = (ci + 1) % colors.length; run = 0; } // brush dips into the next colour
            stamps.push({
              x: lastPt.x + (dx * i) / steps,
              y: lastPt.y + (dy * i) / steps,
              r: (30 + Math.random() * 26) * dpr,
              c: colors[ci],
              a: 0.13,
              born: performance.now(),
            });
          }
          if (stamps.length > 360) stamps.splice(0, stamps.length - 360);
        }
        lastPt = { x, y };
        if (!raf) raf = requestAnimationFrame(loop);
      });
      heroEl.addEventListener("pointerleave", () => { lastPt = null; });
    }
  </script>

  <script>
    // Animated stat counters, triggered once on scroll into view.
    const counters = document.querySelectorAll<HTMLElement>(".count-up");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const run = (el: HTMLElement) => {
      const target = Number(el.dataset.count || 0);
      const suffix = el.dataset.suffix || "";
      if (reduce) { el.textContent = target + suffix; return; }
      const dur = 1400;
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / dur);
        const eased = 1 - Math.pow(1 - p, 3);
        el.textContent = Math.round(target * eased) + suffix;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    };
    if (counters.length) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) { run(e.target as HTMLElement); io.unobserve(e.target); }
          }
        },
        { threshold: 0.5 }
      );
      counters.forEach((c) => io.observe(c));
    }
  </script>
